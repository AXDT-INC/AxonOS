## AxonOS environment configuration (example)
##
## Copy this file to `.env` and fill in values.
## Do NOT commit your `.env` file.
##
## Notes:
## - Some values are used at build-time (Docker build arg PASSWORD), others at run-time.
## - For docker compose: AXONOS_VNC_PASSWORD is passed as build arg; runtime env from .env.
##   docker-compose.yml sets AXGT_CHALLENGE_DB_URL to the bundled postgres service — omit it in
##   .env unless you override (external DB) or run without compose.
##
## Compose (public-beta): from repo root with .env —
##   docker compose up -d --build
## Project axonos, image axonos:public-beta, ports 6080 (noVNC) / 8889 (gate),
## containers axonos / axonos_postgres / axonos_session_launcher.
## Optional port overrides: AXONOS_PUBLISH_NOVNC, AXONOS_PUBLISH_GATE.
## Control services use axonos_control. Each tenant session gets a private
## axgt-session-net-<session-id> bridge shared only with the central axonos gate.

# ---- Build-time / VNC credentials ----
# Used as Docker build arg: --build-arg PASSWORD="$AXONOS_VNC_PASSWORD"
# IMPORTANT: set a strong value (used for VNC + in-container sudo)
AXONOS_VNC_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ---- GPU driver packages (image build) ----
# Keep the image on the same NVIDIA major branch as host `nvidia-smi`. AxonOS relinks Xorg GLX
# to the host-matched module injected by NVIDIA at container startup, which protects sessions
# across automatic host patch updates; an explicit package pin remains useful for reproducibility.
# Set NVIDIA_DRIVER_PKG_VERSION to the driver triplet OR a full apt version; the build resolves a
# single version installable for all four packages (xserver, libnvidia-gl/cfg1/common).
# Host `apt-cache madison` on the server can list …-0ubuntu0.22.04.1 while the CUDA-based image
# build only has a complete 4-package set at …-0ubuntu1 for 535.288 — the resolver maps that.
# Examples (match host nvidia-smi Driver Version):
#   Host 535.288.01 -> NVIDIA_DRIVER_PKG_VERSION=535.288.01-0ubuntu1
#   Host 535.309.01 -> NVIDIA_DRIVER_PKG_VERSION=535.309.01-0ubuntu0.22.04.1
# Or use the triplet only: NVIDIA_DRIVER_PKG_VERSION=535.288.01
# docker compose passes this as Dockerfile build ARG (see docker-compose.yml).

# ---- AXGT Gate / Wallet verification ----
AXGT_CONTRACT_ADDRESS=0xREPLACE_WITH_AXGT_CONTRACT_ADDRESS
# Optional: ERC-20 decimals for in-page "Send min AXGT" (default 18).
# AXGT_TOKEN_DECIMALS=18
# Must match the chain where AXGT / revenue wallet live. noVNC shows mainnet vs testnet from this (see novnc-theme/vnc.html).
# Sepolia example: 11155111. Production mainnet: 1.
AXGT_CHAIN_ID=1
AXGT_RPC_URL=https://REPLACE_WITH_RPC_ENDPOINT
# Revenue wallet: users deposit AXGT here; tx-hash verification credits minutes.
AXGT_REVENUE_WALLET=0xREPLACE_WITH_REVENUE_WALLET

# Dedicated test-credit rail for approved wallets. Disabled by default; a wallet
# list alone never enables token-free credit. Grants require an authenticated POST
# to /api/auth/test-credit and are recorded separately from paid deposits.
# AXONOS_TEST_CREDITS_ENABLED=false
# AXONOS_TEST_CREDIT_WALLETS=0x90F8bf6553474585a147e0689b8E40798C0B29fd,0x25F8...
# Minutes per grant (default 60, hard maximum 1440).
# AXONOS_TEST_CREDIT_GRANT_MINUTES=60
# Legacy/bounded-rail ceiling, including partial grants (default 60, hard maximum
# 10080; used for paths such as guest funding). Eligible wallet
# button clicks are additive and each add AXONOS_TEST_CREDIT_GRANT_MINUTES.
# AXONOS_TEST_CREDIT_MAX_BALANCE_MINUTES=60
# Compatibility wallet-list alias only; setting it never enables test credits.
# AXONOS_WHITELISTED_WALLETS=0x90F8bf6553474585a147e0689b8E40798C0B29fd

# --- Wallet-free demo sessions (guest mode) ---------------------------------
# Lets a sales prospect launch a real desktop from a demo link with no wallet at
# all, then meet the wallet afterwards as an upsell. Disabled by default; demo
# sessions can ONLY be started by redeeming an admin-issued invite token (see
# scripts/guest_invite.py or POST /api/admin/guest-invite) -- there is no
# anonymous self-serve path, and existing invite rows are inert while this is off.
# A demo runs on a synthetic identity that cannot deposit, pay via x402, take
# test credit, use SSH, or keep a persistent storage volume.
# AXONOS_GUEST_MODE_ENABLED=false
# Who may create demo links. Defaults to the AXONOS_TEST_CREDIT_WALLETS list:
# a wallet already trusted with free compute for itself is the same person who
# hands prospects a demo. Set this to decouple the two groups. Minting requires a
# signed-in wallet (POST /api/auth/guest-invite), so every link is attributable —
# no infra secret is handed to the people creating demos. The admin-secret route
# and scripts/guest_invite.py remain for hosts with no signed-in wallet.
# Note: unlike the test-credit rail, this does NOT require
# AXONOS_TEST_CREDITS_ENABLED — the two features are independent.
# AXONOS_GUEST_INVITE_MINTERS=0x90F8bf6553474585a147e0689b8E40798C0B29fd
#
# Per-sponsor quotas. Each redemption mints a NEW identity with its own ledger
# row, so the test-credit balance cap (which bounds one identity) cannot bound a
# team member who mints many links — only these can. The live cap is what
# actually protects the GPU fleet.
# AXONOS_GUEST_MAX_LIVE_PER_SPONSOR=2
# AXONOS_GUEST_MAX_INVITES_PER_DAY=20
#
# Wall-clock cap per demo session, enforced server-side and not renewable
# (default 30, hard maximum 240).
# AXONOS_GUEST_SESSION_MINUTES=30
# Lead time for the "demo is ending" upsell warning, in minutes before the cap
# (default 5; 0 disables it; clamped below the session length).
# AXONOS_GUEST_WARN_MINUTES=5
# Hardware tiers a demo may launch. This is the cost lever, so it defaults to
# the single-GPU tier only rather than to everything.
# AXONOS_GUEST_ALLOWED_PROFILES=small
# Environments a demo may launch. Unset = any (template choice does not change
# what a demo costs); set it to curate what a prospect sees.
# AXONOS_GUEST_ALLOWED_TEMPLATES=pytorch
# How long a minted demo LINK stays redeemable, in hours (default 168 = 7 days).
# AXONOS_GUEST_INVITE_TTL_HOURS=168
# Ledger headroom added on top of the demo's affordable minutes, so the
# wall-clock cap is what ends a demo rather than credit exhaustion (which would
# park the container in credit-grace holding a GPU). Default 5.
# AXONOS_GUEST_CREDIT_BUFFER_MINUTES=5
# Expired per-demo identity and credit rows are pruned in bounded batches after
# this many days (default 30). Invite and generic session audit rows are kept.
# Set 0 only when indefinite raw demo-credit history is required.
# AXONOS_GUEST_DATA_RETENTION_DAYS=30

# Deposit verification (tx-hash based)
AXGT_DEPOSIT_MIN_CONFIRMATIONS=6
# ETH is the primary payment currency (default). 1 ETH → ETH_CREDIT_PER_ETH_MINUTES of
# desktop time. 0.0005 ETH (the default minimum) → 60 minutes at standard rates.
ETH_MIN_DEPOSIT=0.0005
ETH_CREDIT_PER_ETH_MINUTES=120000
# Feature flag (default true). Set false to disable ETH deposit verification/UI.
# AXGT_ENABLE_ETH_DEPOSITS=true
AXGT_WARNING_THRESHOLD_MINUTES=10

# ---- USDC deposits / x402 (stablecoin rail) ----
# USDC is a third payment rail alongside AXGT/ETH, self-verified on-chain (no
# facilitator) and credited into the same deposit ledger. USDC lands in the SAME
# revenue wallet (AXGT_REVENUE_WALLET above) on the USDC chain (Base by default).
# Two ways to pay:
#   1. tx-hash rail — user sends a USDC transfer and it is verified by tx hash
#      (POST /api/auth/verify-usdc-deposit). This drives the in-page "Pay with USDC"
#      button; it appears only when USDC_CONTRACT_ADDRESS is set below.
#   2. x402 protocol — an x402-native client signs an EIP-3009
#      transferWithAuthorization; GET /api/x402/access returns HTTP 402 with
#      payment requirements and POST /api/x402/settle settles it (we pay gas).
#
# The USDC/x402 chain is independent of AXGT_CHAIN_ID above — x402 + Circle's
# gasless (EIP-3009) USDC are Base-native, so this rail runs on Base even when the
# AXGT/ETH rail is on Ethereum mainnet/Sepolia.
#
# --- Base Sepolia testnet (default for testing) ---
# USDC_RPC_URL=https://sepolia.base.org
# Base Sepolia test USDC (Circle):
# USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# USDC_CHAIN_ID=84532
# USDC_NETWORK=base-sepolia
#
# --- Base mainnet (production) ---
# USDC_RPC_URL=https://mainnet.base.org
# USDC_CONTRACT_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# USDC_CHAIN_ID=8453
# USDC_NETWORK=base
#
# Optional (defaults shown): 1 USDC -> 60 minutes; minimum 1 USDC.

# Public x402 resource URLs used in payment requirements and AgentLink URI validation.
# X402_RESOURCE_URL should be the exact public paid-session endpoint, not just the site base.
# X402_RESOURCE_URL=https://app.axonos.io/api/x402/session
# X402_ACCESS_RESOURCE_URL=https://app.axonos.io/api/x402/access
# AXGT_PUBLIC_BASE_URL=https://app.axonos.io

# Direct file plane (optional): serve bulk /api/files/* from the host's public
# TCP 443 via the files-tls demux service (shares 443 with TURN-over-TCP; see
# docker/files-tls/nginx.conf.template). Requires a Let's Encrypt cert for
# FILES_TLS_SERVER_NAME in the axonos_letsencrypt volume. The frontend
# discovers the base via /api/public/files-config and silently falls back to
# same-origin (through the web proxy) when unset or unreachable.
# AXGT_FILES_PUBLIC_BASE=https://files.example.org
# FILES_TLS_SERVER_NAME=files.example.org

# Merchant contact email published as info.contact.email in /openapi.json. x402
# marketplaces (e.g. Poncho) use it to verify origin ownership, let users contact you,
# and customize merchant pages. Omitted from /openapi.json when unset. Prefer an
# address on your origin domain (e.g. you@axonos.io) so ownership verification passes.
# AXGT_CONTACT_EMAIL=you@axonos.io

# ---- AgentLink identity layer (optional, x402 extension) ----
# AgentLink adds verified-human-backed agent identity metadata alongside the x402/Bazaar
# payment flow. It does NOT grant free access, discounts, credits, or payment bypasses
# in the current implementation.
#
# Disabled by default. When false/unset, x402/Bazaar behavior should remain unchanged.
AXGT_AGENTLINK_ENABLED=false
#
# Supported current modes:
#   advertise_only = include extensions.agentlink in 402 PaymentRequired responses only
#   verify_only    = passively verify incoming `agentlink` headers and annotate responses;
#                    normal x402 payment is still required
# Free/trial/discount/allowlist modes are intentionally not implemented.
AXGT_AGENTLINK_MODE=advertise_only
#
# Optional RPC override for Biomapper Agent Registry lookups.
# Defaults to USDC_RPC_URL when unset.
# AXGT_AGENTLINK_RPC_URL=
#
# Optional BiomapperAgentRegistry override.
# If unset, the gateway selects the default registry by USDC_CHAIN_ID:
#   Base mainnet 8453 -> 0x7Ef35Bf180dcDAA5AB6cdEC7e9DED6230aD12263
#   Base Sepolia 84532 -> 0xc0fb26BaACe7E1BCb3aFFD547AD5f2cAc4A4F51b
# AXGT_AGENTLINK_REGISTRY_ADDRESS=
#
# Max allowed age, in seconds, for AgentLink issuedAt freshness validation.
# Nonce replay protection is stored in Postgres via AXGT_CHALLENGE_DB_URL.
AXGT_AGENTLINK_MAX_AGE_SECONDS=300
#
# verify_only mode requires Postgres nonce replay protection via AXGT_CHALLENGE_DB_URL.
# With docker compose, AXGT_CHALLENGE_DB_URL is injected for the bundled Postgres service;
# set it manually only for external DB / non-compose deployments.

# USDC_MIN_DEPOSIT=1
# USDC_CREDIT_PER_USDC_MINUTES=60
# USDC_DEPOSIT_MIN_CONFIRMATIONS=6
# Feature flag (default true). Set false to disable the USDC rail + UI.
# AXGT_ENABLE_USDC_DEPOSITS=true
#
# x402 EIP-3009 settlement only (POST /api/x402/settle). The settlement signer
# broadcasts transferWithAuthorization and PAYS GAS, so this EOA must hold a small
# ETH-on-Base balance. Use a dedicated low-balance hot wallet — NEVER the revenue
# or treasury key. Leave unset to keep /api/x402/settle disabled (the tx-hash rail
# above still works without it).
# X402_SETTLEMENT_PRIVATE_KEY=0xREPLACE_WITH_DEDICATED_SETTLEMENT_KEY
# AXGT_ENABLE_X402_SETTLEMENT=true
#
# EIP-712 domain for the USDC contract — MUST match the token's on-chain domain or
# /settle signature recovery fails. The name differs between mainnet and testnet:
#   Base mainnet USDC: name="USD Coin"  (the code default), version="2"
#   Base Sepolia USDC: name="USDC",     version="2"   <-- set this on testnet
# If unsure, read name()/version() from the token contract on-chain.
# USDC_EIP712_NAME=USDC
# USDC_EIP712_VERSION=2
#
# ---- x402 settlement rail: self-settle (default) vs CDP facilitator (Bazaar) ----
# By default the gate SELF-SETTLES: it broadcasts the EIP-3009 authorization itself
# (X402_SETTLEMENT_PRIVATE_KEY above) and pays gas. This rail is private — it does
# NOT appear in the Coinbase x402 Bazaar, because CDP only indexes resources it has
# settled at least once.
#
# To get listed at https://docs.cdp.coinbase.com/x402/bazaar, opt into the CDP
# facilitator rail. When enabled, /api/x402/* routes VERIFY+SETTLE through CDP
# (CDP broadcasts + pays gas) and CDP catalogs the resource on first settlement.
# Self-settle is left fully intact; this only changes who broadcasts when the flag
# is on. Requires a CDP API key from https://portal.cdp.coinbase.com.
# AXGT_X402_FACILITATOR_ENABLED=true
# CDP_API_KEY_ID=your-cdp-api-key-id
# CDP_API_KEY_SECRET=your-cdp-api-key-secret
# CDP_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402   # default
#
# Bazaar listing metadata (only used in facilitator mode). Discoverable defaults to
# true when the facilitator is on. Category/tags are what agents see in the catalog.
# AXGT_X402_BAZAAR_DISCOVERABLE=true
# AXGT_X402_BAZAAR_CATEGORY=compute
# AXGT_X402_BAZAAR_TAGS=gpu,compute,ssh,linux

# ---- AXGT holder discount tiers (ETH-first tokenomics) ----
# AXGT is no longer required as a payment token. Holders of AXGT receive a
# tiered discount on the ETH price for compute/session credits. The backend
# verifies the AXGT balance on-chain via direct JSON-RPC ``balanceOf`` against
# AXGT_CONTRACT_ADDRESS and AXGT_RPC_URL — never trust client-reported balances.
#
# Configure tiers via ONE of the following (first non-empty wins; otherwise the
# defaults below are used):
#   1. AXGT_DISCOUNT_TIERS_JSON: JSON list of {min_axgt, discount_percent, label}
#      e.g.  '[{"min_axgt":0,"discount_percent":0,"label":"Tier 0"},
#               {"min_axgt":100,"discount_percent":5,"label":"Tier 1"}]'
#   2. AXGT_DISCOUNT_TIERS_FILE: path to a JSON file (same shape).
#   3. AXGT_DISCOUNT_TIERS: compact "min:percent[,min:percent...]" form
#      e.g.  AXGT_DISCOUNT_TIERS=0:0,100:5,1000:10,10000:15,100000:25
#
# Defaults (matches docs/TOKENOMICS.md):
#   Tier 0:        0 –     99 AXGT  →  0% discount
#   Tier 1:      100 –    999 AXGT  →  5% discount
#   Tier 2:    1,000 –  9,999 AXGT  → 10% discount
#   Tier 3:   10,000 – 99,999 AXGT  → 15% discount
#   Tier 4:  100,000+         AXGT  → 25% discount
# AXGT_DISCOUNT_TIERS=0:0,100:5,1000:10,10000:15,100000:25

# Legacy: direct AXGT deposits (AXGT-as-payment). Default false in ETH-first
# tokenomics. Set to true ONLY if you want to keep accepting AXGT as a direct
# payment token (e.g. for migration / private beta backward compatibility).
# AXGT_ENABLE_AXGT_DEPOSITS=false
# AXGT direct-deposit knobs (consulted when AXGT_ENABLE_AXGT_DEPOSITS=true):
# AXGT_MIN_DEPOSIT=100
# AXGT_CREDIT_PER_100_AXGT_MINUTES=60
# Model B: paying IN AXGT gets a flat bonus and NO holder tier (holder tiers apply
# to ETH/USDC only). Bonus = extra minutes vs the USD-equivalent. Default +25%.
# AXGT_USD_BONUS_PERCENT=25

# ---- Dynamic USD-equivalent pricing (price oracle) ----
# Off by default. When on, ETH and AXGT deposits are credited at their LIVE USD
# value. AXGT uses a 30-minute TWAP from the same Uniswap v3 AXGT/WETH pool and
# Chainlink ETH/USD sources as the axondao.io dashboard. If TWAP history is not
# available, the dashboard-compatible spot quote is accepted only when CoinGecko
# agrees within the guard threshold. Large TWAP changes need the same confirmation;
# CoinGecko is otherwise an outage fallback.
# Prices refresh every 5 minutes and are cached in Postgres. USDC stays fixed.
# Minutes are priced at AXGT_USD_PER_HOUR. On feed outage the last-known price is
# used up to PRICE_MAX_STALE_SECONDS, then it falls back to the fixed crypto rates.
# Introduces a price oracle (a deliberate change from the prior no-oracle stance);
# it reads server-side cache only and never trusts client-reported prices.
# AXGT_DYNAMIC_PRICING=false
# AXGT_USD_PER_HOUR=1.0
# ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# AXGT_UNISWAP_V3_POOL=0xf9c56A9CcC1398Bed3C519ef2F0B42CE52AaA440
# AXGT_TWAP_WINDOW_SECONDS=1800
# AXGT_MAX_PRICE_DEVIATION_PERCENT=25
# AXGT_COINGECKO_ID=axondao-governance-token-2
# PRICE_POLL_INTERVAL_SECONDS=300     # 5 minutes, matching the dashboard
# PRICE_MAX_STALE_SECONDS=86400       # refuse prices older than 24h

# CORS allowlist for /api/*. Empty = same-origin only.
# AXGT_CORS_ORIGINS=
# AXGT_RATE_LIMIT_PER_MIN=30

# ---- Postgres (deposit ledger, challenges, auth, sessions) ----
# Required for deposit-credit billing. With repo docker-compose.yml: NOT needed in .env —
# compose injects AXGT_CHALLENGE_DB_URL into the axonos container from the postgres service.
# Set here only for non-compose deploys or to point at an external database:
# AXGT_CHALLENGE_DB_URL=postgresql://user:pass@host:5432/dbname

# Credentials for the bundled postgres service (docker-compose). Override in .env if needed.
# POSTGRES_USER=axonos_gate
# POSTGRES_PASSWORD=axonos_gate_secret
# POSTGRES_DB=axonos_gate

# ---- Auth/session hardening ----
AXGT_AUTH_TOKEN_TTL_SECONDS=300
AXGT_CHALLENGE_TTL_SECONDS=180
AXGT_AUTH_COOKIE_NAME=axgt_auth_token
AXGT_AUTH_COOKIE_SECURE=true
AXGT_AUTH_ROTATE_BEFORE_EXPIRY_SECONDS=60
AXGT_AUTH_GRACE_SECONDS=15

# ---- Single-active-session lock & queue ----
# Sliding runtime lease in minutes: extended on each heartbeat; session ends (container stopped) if
# no heartbeat for this long or AXGT_HEARTBEAT_TIMEOUT_SECONDS, whichever applies first.
AXGT_SESSION_MAX_MINUTES=60
# Seconds without a heartbeat before the session is considered stale and auto-released.
AXGT_HEARTBEAT_TIMEOUT_SECONDS=120
# Runtime heartbeat cadence injected into every tenant container. Keep this
# comfortably below AXGT_HEARTBEAT_TIMEOUT_SECONDS (default: 30 seconds).
# AXGT_HEARTBEAT_INTERVAL_SECONDS=30
# Headless/SSH HARD billing cap (minutes). Unlike AXGT_SESSION_MAX_MINUTES (which
# slides forward on every healthy runtime heartbeat), this is a NON-sliding ceiling
# so an abandoned SSH session — kept alive by the in-container heartbeat daemon
# with no "user left" browser signal — can't drain the whole prepaid balance. The
# effective cap is min(this ceiling, the wallet's affordable minutes). 0/unset =
# no operator ceiling (cap is then just affordability). Does NOT affect desktop
# sessions; those use explicit End/page-close release and prepaid exhaustion.
# Bill at most what was bought; the agent/user stops early with an explicit release.
# NOTE: since SSH sessions survive tab close (2026-07-09), this ceiling is the
# main bound on a forgotten browser-launched SSH session too — keep it small
# relative to typical balances (240 = 4h recommended; 1440 lets a well-funded
# wallet bill a full day).
# AXGT_SSH_MAX_SESSION_MINUTES=240
# Optional: cooldown in seconds before the same wallet can reclaim after releasing.
AXGT_SESSION_COOLDOWN_SECONDS=0
# Optional: shell script executed when the desktop session transitions between users.
# Default in container: /usr/local/bin/reset_session.sh (desktop cleanup + XFCE restart)
AXGT_SESSION_RESET_SCRIPT=/usr/local/bin/reset_session.sh

# ---- UI branding ----
# Hide the "BETA" chip beside the AxonOS brand in the top bar. Default: true (chip hidden).
# Set to false to show the chip.
# AXONOS_HIDE_BETA_BADGE=true

# ---- Multi-session (exclusive whole-GPU allocation) ----
# Enabled when per-user containers are on. Legacy shared-desktop deployments
# must set this false; code also forces it off when user containers are disabled.
# AXGT_MULTI_SESSION_ENABLED=true
# AXGT_GPU_PROFILES_ENABLED=true
# Fixed profile map:
#   small=1 GPU, medium=2 GPUs, large=4 GPUs, max=8 GPUs
# Usage billing (with profiles enabled): deducts wall_clock_minutes × GPU count per heartbeat.
# Set AXGT_GPU_WEIGHTED_BILLING=false to bill 1× regardless of profile (not recommended).
# AXGT_DEFAULT_GPU_PROFILE=small
# AXGT_GPU_DEVICE_IDS=0,1,2,3,4,5,6,7
# AXGT_GPU_TOTAL_COUNT=8
# When unset, scheduler calls nvidia-smi to list visible GPU indices (Docker-friendly).
# AXGT_GPU_AUTO_DETECT=true
# TTL for cached auto-detected list (seconds).
# AXGT_GPU_DEVICE_CACHE_SECONDS=120
# Central gate GPU telemetry uses one persistent NVML process rather than
# repeatedly spawning nvidia-smi. Values are clamped to 0.5–60 seconds.
# AXGT_GPU_TELEMETRY_INTERVAL_SECONDS=1.0
# AXGT_GPU_TELEMETRY_FILE=/run/axonos/gpu-telemetry.json
# Compose gives the gate-only base container NVIDIA utility access so this
# central collector can see the fleet; tenant sessions still receive exact GPUs.
# GPU-less gate + http launcher: probe host via GET /enumerate-gpus on the launcher.
# AXGT_GPU_ENUMERATE_VIA_LAUNCHER=true
# AXGT_SESSION_LAUNCHER_ENUMERATE_TIMEOUT_SECONDS=90
# Optional smaller image for probe (default: AXGT_HOST_SESSION_CONTAINER_IMAGE).
# AXGT_LAUNCHER_GPU_ENUMERATE_IMAGE=nvidia/cuda:12.3.2-base-ubuntu22.04
#
# When prepaid credit hits zero, stop viewer access and compute billing but retain the same running
# container, jobs, and GPU assignment for top-up (default true). The logical grace expires after:
# AXGT_SESSION_CREDIT_GRACE_MINUTES=120
# Legacy fallback during migration: AXGT_SESSION_PAUSED_MAX_MINUTES=120
# The container and its jobs continue running during the grace.
# Cleanup auto-stops it when the grace expires. Set the following false for immediate teardown.
# AXGT_SESSION_PRESERVE_ON_CREDIT_EXHAUST=true
#
# Optional: one container per claimed session (exclusive assigned GPUs only).
# AXGT_USER_CONTAINER_ENABLED=true
# When true, base axonos is gate-only (AXGT_DESKTOP_ENABLED=false); desktops run in axgt-session-*.
# Runtime enable flags are mode-owned; do not add AXGT_DESKTOP_ENABLED,
# WEBRTC_ENABLED, or WEBRTC_AGENT_ENABLED to the passthrough list.
# AXGT_DESKTOP_ENABLED=false
# Base compose must not reserve GPUs when user containers are enabled (see docker-compose.yml axonos service).
# Launcher adapter mode:
#   docker_cli (default) -> runs `docker run` from gate runtime
#   http                -> delegates launch/stop to external launcher service
#   noop                -> scheduler-only dry run, no runtime orchestration
# AXGT_SESSION_LAUNCHER_MODE=http
# AXGT_SESSION_LAUNCHER_URL=http://axonos-launcher:8090
# AXGT_SESSION_LAUNCHER_TOKEN=replace_with_shared_secret
# HTTP timeout (seconds) for launch/stop calls to the launcher. Default 90.
# `docker run -d` of a GPU desktop (cold image cache, nvidia-runtime init,
# --shm-size 32g, daemon contention) routinely exceeds the old 10s default; a
# premature timeout was being reported as "Failed to start user container"
# even though the container went on to start (false positive on session start).
# AXGT_SESSION_LAUNCHER_TIMEOUT_SECONDS=90
# If a /launch call is inconclusive (timeout/transient error), the gate retries
# the identical idempotent request. Only the host launcher's exact allocation,
# runtime-digest, and network checks can confirm success. Retry cadence:
# AXGT_SESSION_LAUNCH_VERIFY_ATTEMPTS=5
# AXGT_SESSION_LAUNCH_VERIFY_INTERVAL_SECONDS=2
# Direct and host-launcher database operations fail within this bounded timeout.
# AXGT_SESSION_DB_CONNECT_TIMEOUT_SECONDS=5
# Isolated session networks are authorized/repaired at this cadence (minimum 5s).
# AXGT_SESSION_NETWORK_RECONCILE_SECONDS=10
#
# Compose-managed launcher defaults (recommended):
# - docker-compose starts `axonos-launcher` service automatically
# - gate uses AXGT_SESSION_LAUNCHER_MODE=http and URL http://axonos-launcher:8090
# - set a real shared secret for AXGT_SESSION_LAUNCHER_TOKEN in .env
#
# Host launcher bind (for compose launcher service or manual host service):
# AXGT_SESSION_LAUNCHER_BIND_HOST=127.0.0.1
# AXGT_SESSION_LAUNCHER_BIND_PORT=8090
# AXGT_HOST_SESSION_CONTAINER_IMAGE=axonos:public-beta
# Required by a manually run host launcher for exact allocation authorization.
# Compose injects its control-plane Postgres URL automatically.
# AXGT_CHALLENGE_DB_URL=postgresql://axonos_gate:password@127.0.0.1:5432/axonos_gate
# Per-session networks are the production default. The launcher creates
# axgt-session-net-<session-id>, attaches the central gate, and removes the
# network when the session stops.
# AXGT_HOST_SESSION_NETWORK_ISOLATION=true
# AXGT_HOST_CENTRAL_GATE_CONTAINER=axonos
# Compatibility fallback used only when isolation is explicitly disabled:
# AXGT_HOST_SESSION_CONTAINER_NETWORK=axonos_stack
# AXGT_HOST_SESSION_CONTAINER_COMMAND=/startup.sh
# AXGT_HOST_SESSION_CONTAINER_EXTRA_ARGS=
# Extra args cannot override networks, ports, host mounts/devices, namespaces,
# capabilities, runtime/security settings, hostname, environment variables,
# ownership labels, label/cid files, Docker API socket injection, or privileged
# mode, and cannot repeat --gpus. Resource/logging knobs such as
# --cpus or --memory remain available; isolation controls belong to the launcher.
# AXGT_HOST_SESSION_CONTAINER_SHM_SIZE=32g
# Passthrough is a media-tuning allowlist. The compose default includes WebRTC
# STUN/TURN, capture, clipboard, public-IP, audio, and microphone settings only.
# Do not forward database, chain/RPC, billing/payment, settlement, launcher, or
# WEBRTC_AGENT_INTERNAL_KEY values into tenant containers.
# AXGT_HOST_SESSION_ENV_PASSTHROUGH=WEBRTC_DISPLAY_WAIT_SECONDS,WEBRTC_STUN_URLS,WEBRTC_TURN_URLS,WEBRTC_TURN_USERNAME,WEBRTC_TURN_CREDENTIAL,WEBRTC_CAPTURE_BACKEND,WEBRTC_CAPTURE_FPS,WEBRTC_CAPTURE_BITRATE,WEBRTC_CAPTURE_NVENC_PRESET,WEBRTC_CAPTURE_NVENC_TUNE,WEBRTC_CAPTURE_NVFBC_BIN,WEBRTC_CAPTURE_NVFBC_PRESET,WEBRTC_CAPTURE_LOW_LATENCY,WEBRTC_CAPTURE_MAX_WIDTH,WEBRTC_CAPTURE_DISPLAY,WEBRTC_LOCAL_CURSOR,WEBRTC_CAPTURE_MAX_STALE_FRAMES,WEBRTC_CLIPBOARD_MAX_BYTES,WEBRTC_CLIPBOARD_POLL_PRIMARY,WEBRTC_PUBLIC_IP,WEBRTC_AUDIO_ENABLED,WEBRTC_AUDIO_SOURCE,WEBRTC_MIC_ENABLED,WEBRTC_MIC_SINK
# The launcher strips NVIDIA_VISIBLE_DEVICES (and similar) from its own environment when
# calling `docker run` so --gpus device=… is not merged with an implicit "all GPUs" request
# (daemon error: cannot set both Count and DeviceIDs on device request).
# Tenant containers are also launched with NET_RAW dropped.
#
# docker_cli mode settings:
# AXGT_SESSION_CONTAINER_IMAGE=axonos:public-beta
# AXGT_SESSION_NETWORK_ISOLATION=true
# AXGT_CENTRAL_GATE_CONTAINER=axonos
# AXGT_SESSION_CONTAINER_NETWORK=axonos_stack  # used only if isolation=false
# AXGT_SESSION_CONTAINER_EXTRA_ARGS=
# AXGT_SESSION_CONTAINER_COMMAND=/startup.sh
#
# Persistent user volume storage settings:
# AXGT_PERSISTENT_STORAGE_ENABLED=true
# Directory on Docker host for backing .ext4 sparse image files (default /var/lib/docker/axonos_storage)
# AXGT_PERSISTENT_STORAGE_DIR=/var/lib/docker/axonos_storage
# AXGT_PERSISTENT_STORAGE_VOLUME_PREFIX=axgt-user-storage-
# AXGT_PERSISTENT_STORAGE_MOUNT_PATH=/home/aXonian
# AXGT_PERSISTENT_STORAGE_CLEANUP_INTERVAL_SECONDS=3600
# AXGT_PERSISTENT_STORAGE_MIN_BALANCE_LIMIT_MINUTES=-1440.0
# AXGT_PERSISTENT_STORAGE_GB_HOUR_COST_MINUTES=0.05

# ---- File transfer + CPU/RAM/storage telemetry (browser <-> session) ----
# Per-session auth is automatic: the gate generates a files key at claim time,
# stores it on the session row, and injects AXGT_SESSION_FILES_KEY into the
# session container; no shared secret needs configuring. The private agent runs
# for desktop and SSH-only sessions but is never published on a host port.
# AXGT_FILES_ENABLED=true
# AXGT_FILES_PORT=8767
# Storage root the in-container agent serves (defaults to the desktop home / persistent volume):
# AXGT_FILES_ROOT=/home/aXonian
# Refuse uploads that would leave less than this much free disk in the container:
# AXGT_FILES_MIN_FREE_BYTES=1073741824
# Optional hard cap per uploaded file (0 = unlimited; storage is billed per GB-hour):
# AXGT_FILES_MAX_FILE_BYTES=0

# ---- Admin API (optional) ----
# Set to enable POST /api/admin/credit-minutes, refund-minutes, adjust-balance, GET /api/admin/ledger.
# Require header X-AXGT-Admin-Secret or query admin_secret.
# AXGT_ADMIN_SECRET=your_secret

# ---- Optional contract safety check ----
# If set, gate only accepts this contract address.
# AXGT_EXPECTED_CONTRACT_ADDRESS=0x6112C3509A8a787df576028450FebB3786A2274d

# ---- Gate server (when used, e.g. tunnel to 8889) ----
# GATE_HOST=0.0.0.0
# GATE_USE_GEVENT=1
# GATE_PORT=8889
# The supervisor starts a separate agent-only listener on container port 8890.
# It is reachable only through per-session networks and is not host-published.
# Do not set GATE_AGENT_API_ENABLED/GATE_AGENT_ONLY on the public :8889 gate.

# ---- WebRTC browser-native desktop streaming (optional) ----
# Set WEBRTC_ENABLED=true to prefer WebRTC. Classic noVNC fallback remains a
# legacy single-container feature; launcher-managed multi-user sessions require
# WebRTC because their VNC listener is deliberately disabled and not published.
# WEBRTC_ENABLED=false
# WEBRTC_FALLBACK_ENABLED=true
# When AXGT_USER_CONTAINER_ENABLED=true, startup.sh disables the capture agent on the base
# container and the launcher passes WEBRTC_AGENT_ENABLED=true into axgt-session-* only (avoids
# two agents racing on the same signaling queue). Override only if you know what you are doing.
# WEBRTC_AGENT_ENABLED=true
# Central capability-signing secret. Generate a long random value and keep it in
# the control plane. It is never forwarded to tenant session containers. The gate
# derives an Ed25519 key, mints a capability bound to the exact session ID, wallet,
# and per-session file key, and the launcher injects that token as
# AXGT_WEBRTC_AGENT_TOKEN automatically.
# WEBRTC_AGENT_INTERNAL_KEY=
# Signed capability lifetime in seconds (default 86400; clamped 600-604800).
# Live agents renew before expiry through the internal-only gate; the signer and
# database credential remain outside tenant containers.
# WEBRTC_AGENT_CAPABILITY_TTL_SECONDS=86400
# Agent-only signaling URL. Launcher-managed tenants are forced to
# http://axonos-gate:8890 through their isolated session network. Legacy single-
# container mode uses loopback; the public :8889/:6080 listeners reject agent APIs.
# WEBRTC_GATE_INTERNAL_URL=http://127.0.0.1:8890
# Seconds to wait for X11 (:0) before capture on a new session desktop (default 120).
# WEBRTC_DISPLAY_WAIT_SECONDS=120
# Desktop audio over WebRTC (Opus track from the PulseAudio null-sink monitor). Default on;
# sessions silently degrade to video-only if PulseAudio capture is unavailable.
# WEBRTC_AUDIO_ENABLED=true
# WEBRTC_AUDIO_SOURCE=axonos_out.monitor
# Microphone (browser -> desktop). OFF by default — separate privacy surface. When true the
# browser shows an opt-in mic toggle (subject to its own getUserMedia prompt) and the agent
# feeds the mic into the virtual axonos_microphone source. Requires a secure origin (HTTPS).
# NOTE (user-container mode): the agent runs in axgt-session-*, so WEBRTC_MIC_ENABLED must be
# forwarded via AXGT_HOST_SESSION_ENV_PASSTHROUGH (already in the compose default list). If you
# set a custom passthrough list, include WEBRTC_AUDIO_ENABLED/WEBRTC_MIC_ENABLED or audio/mic
# silently stay at their code defaults (audio on, mic off) regardless of what the base sets.
# WEBRTC_MIC_ENABLED=false
# WEBRTC_MIC_SINK=axonos_mic
# Browser polls for SDP answer this long (default 180000 ms; must exceed display wait + ICE).
# WEBRTC_ANSWER_WAIT_MS=180000
# Optional abandoned-offer recovery lease (30-540 seconds). Unset derives it
# from the answer/display waits so healthy slow startup is not reclaimed.
# WEBRTC_AGENT_CLAIM_LEASE_SECONDS=
# Gate API bind (axonos service): use 0.0.0.0 so tenant heartbeats reach http://axonos-gate:8889.
# GATE_HOST=0.0.0.0
# GATE_PORT=8889
# Comma-separated ICE URLs (stun: and turn:). Multi-user session networks do
# not share the compose coturn network, so use a publicly reachable hostname/IP,
# not the internal `coturn` service alias. Keep TURN passwords in env/secrets.
# WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
# WEBRTC_TURN_URLS=
# WEBRTC_TURN_USERNAME=
# WEBRTC_TURN_CREDENTIAL=
# WEBRTC_SESSION_TIMEOUT_SECONDS=600
# WEBRTC_MAX_RECONNECT_ATTEMPTS=5
# Rate limit signaling POSTs per IP+wallet per minute (0 = unlimited).
# WEBRTC_SIGNAL_RATE_LIMIT_PER_MIN=60
# Remote→browser clipboard poll uses X CLIPBOARD only (avoids PRIMARY noise like
# desktop icon labels overwriting the host clipboard). Set to 1 to include PRIMARY
# for legacy apps that never populate CLIPBOARD.
# WEBRTC_CLIPBOARD_POLL_PRIMARY=0
# Capture backend: auto (NvFBC when installed, else NVENC, else MSS/VP8), nvfbc, nvenc, or mss.
# WEBRTC_CAPTURE_BACKEND=auto
# WEBRTC_CAPTURE_DISPLAY=:0
# WEBRTC_CAPTURE_MAX_WIDTH=1920
# WEBRTC_CAPTURE_FPS=30
# NVENC H.264 target bitrate in bps (default 12000000 = 12 Mbps).
# For 1080p30, 10-14 Mbps is usually the useful range; lower this before
# lowering FPS if packet loss climbs through TURN.
# WEBRTC_CAPTURE_BITRATE=12000000
# NVENC preset (p1–p7; p1 has the lowest latency; p4 is cleaner but can lag).
# WEBRTC_CAPTURE_NVENC_PRESET=p1
# NVENC tune: ll (default), ull (lower delay/more artifacts), hq (cleaner/more delay).
# WEBRTC_CAPTURE_NVENC_TUNE=ll
# NvFBC streamer binary/preset. Requires building tools/nvfbc_nvenc_streamer.c with
# the NVIDIA Capture SDK headers.
# WEBRTC_CAPTURE_NVFBC_BIN=/usr/local/bin/nvfbc_nvenc_streamer
# WEBRTC_CAPTURE_NVFBC_PRESET=llhp
# One-frame VBV for absolute lowest latency; set false for ~3 frames of quality cushion.
# WEBRTC_CAPTURE_LOW_LATENCY=true
# Browser overlay cursor: auto (off when NVENC embeds host cursor), true, or false
# WEBRTC_LOCAL_CURSOR=auto

# ---- Headless SSH + browser-terminal session toggle (runtime) ----
# The landing page can launch a headless GPU session with no X desktop/WebRTC.
# The authenticated browser terminal opens in the existing viewer surface over
# a private per-session agent; direct SSH remains available as a fallback and
# for SCP/SFTP/port forwarding. The user pastes a public key and the gate also
# returns an `ssh -p <port> <user>@<host>` connect-string. Each session publishes one host
# TCP port from 42000-42049 (= 42000 + session_id % 50) mapped to container :22,
# so inbound TCP 42000-42049 must be open on AXGT_SSH_PUBLIC_HOST's firewall.
# Set AXGT_SSH_PUBLIC_HOST to the media-plane public IP (the one the per-session
# ports NAT to) — NOT the landing-page hostname, which is the OKE proxy and does
# not carry the SSH ports. Leaving it empty makes the external command unusable,
# but does not disable the same-origin browser terminal.
# AXGT_SSH_PUBLIC_HOST=206.41.207.99
# Login user shown in the connect-string (must be the in-container desktop user).
# AXGT_SSH_USER=aXonian
# Browser terminal capability. The private agent uses fixed container port 8791;
# that port is intentionally never published on the host.
# AXGT_TERMINAL_ENABLED=true
# One-use browser ticket lifetime (seconds, clamped to 5-60; default 30).
# AXGT_TERMINAL_TICKET_TTL_SECONDS=30
# Revalidate active ownership, allocation, expiry, and prepaid credit while the
# terminal is attached (seconds, clamped to 1-30; default 5).
# AXGT_TERMINAL_REVALIDATE_SECONDS=5
# Private-agent connect timeout (seconds, clamped to 1-15; default 5).
# AXGT_TERMINAL_CONNECT_TIMEOUT_SECONDS=5

# ---- IPFS exposure (runtime, optional) ----
# Only set if you intentionally expose IPFS endpoints.
# IPFS_API_BIND=127.0.0.1
# IPFS_API_PORT=5001
# IPFS_GATEWAY_BIND=127.0.0.1
# IPFS_GATEWAY_PORT=8080

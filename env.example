## AxonOS environment configuration (example)
##
## Copy this file to `.env` and fill in values.
## Do NOT commit your `.env` file.
##
## Notes:
## - Some values are used at build-time (Docker build arg PASSWORD), others at run-time.
## - For docker compose: AXONOS_VNC_PASSWORD is passed as build arg; runtime env from .env.
##   docker-compose.yml sets AXGT_CHALLENGE_DB_URL to the bundled postgres service — omit it in
##   .env unless you override (external DB) or run without compose.
##
## Compose (public-beta): from repo root with .env —
##   docker compose up -d --build
## Project axonos, image axonos:public-beta, ports 6080 (noVNC) / 8889 (gate),
## containers axonos / axonos_postgres / axonos_session_launcher.
## Optional port overrides: AXONOS_PUBLISH_NOVNC, AXONOS_PUBLISH_GATE.
## Do not set COMPOSE_PROJECT_NAME unless you also set
## AXGT_HOST_SESSION_CONTAINER_NETWORK to match (${COMPOSE_PROJECT_NAME}_default).
## Default session network is the fixed bridge axonos_stack (see docker-compose.yml).

# ---- Build-time / VNC credentials ----
# Used as Docker build arg: --build-arg PASSWORD="$AXONOS_VNC_PASSWORD"
# IMPORTANT: set a strong value (used for VNC + in-container sudo)
AXONOS_VNC_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ---- GPU driver packages (image build) ----
# Container libnvidia-gl / xserver-xorg-video-nvidia MUST match host `nvidia-smi` "Driver Version"
# (e.g. 535.288.01). If the image pulls newer userspace (e.g. 535.309) while the host kernel
# driver is older, Xorg aborts (exit 134) with mismatched GLX vs dlloader in /var/log/Xorg.0.log.
# Set NVIDIA_DRIVER_PKG_VERSION to the driver triplet OR a full apt version; the build resolves a
# single version installable for all four packages (xserver, libnvidia-gl/cfg1/common).
# Host `apt-cache madison` on the server can list …-0ubuntu0.22.04.1 while the CUDA-based image
# build only has a complete 4-package set at …-0ubuntu1 for 535.288 — the resolver maps that.
# Examples (match host nvidia-smi Driver Version):
#   Host 535.288.01 -> NVIDIA_DRIVER_PKG_VERSION=535.288.01-0ubuntu1
#   Host 535.309.01 -> NVIDIA_DRIVER_PKG_VERSION=535.309.01-0ubuntu0.22.04.1
# Or use the triplet only: NVIDIA_DRIVER_PKG_VERSION=535.288.01
# docker compose passes this as Dockerfile build ARG (see docker-compose.yml).

# ---- AXGT Gate / Wallet verification ----
AXGT_CONTRACT_ADDRESS=0xREPLACE_WITH_AXGT_CONTRACT_ADDRESS
# Optional: ERC-20 decimals for in-page "Send min AXGT" (default 18).
# AXGT_TOKEN_DECIMALS=18
# Must match the chain where AXGT / revenue wallet live. noVNC shows mainnet vs testnet from this (see novnc-theme/vnc.html).
# Sepolia example: 11155111. Production mainnet: 1.
AXGT_CHAIN_ID=1
AXGT_RPC_URL=https://REPLACE_WITH_RPC_ENDPOINT
# Revenue wallet: users deposit AXGT here; tx-hash verification credits minutes.
AXGT_REVENUE_WALLET=0xREPLACE_WITH_REVENUE_WALLET

# Deposit verification (tx-hash based)
AXGT_DEPOSIT_MIN_CONFIRMATIONS=6
# ETH is the primary payment currency (default). 1 ETH → ETH_CREDIT_PER_ETH_MINUTES of
# desktop time. 0.0005 ETH (the default minimum) → 60 minutes at standard rates.
ETH_MIN_DEPOSIT=0.0005
ETH_CREDIT_PER_ETH_MINUTES=120000
# Feature flag (default true). Set false to disable ETH deposit verification/UI.
# AXGT_ENABLE_ETH_DEPOSITS=true
AXGT_WARNING_THRESHOLD_MINUTES=10

# ---- AXGT holder discount tiers (ETH-first tokenomics) ----
# AXGT is no longer required as a payment token. Holders of AXGT receive a
# tiered discount on the ETH price for compute/session credits. The backend
# verifies the AXGT balance on-chain via direct JSON-RPC ``balanceOf`` against
# AXGT_CONTRACT_ADDRESS and AXGT_RPC_URL — never trust client-reported balances.
#
# Configure tiers via ONE of the following (first non-empty wins; otherwise the
# defaults below are used):
#   1. AXGT_DISCOUNT_TIERS_JSON: JSON list of {min_axgt, discount_percent, label}
#      e.g.  '[{"min_axgt":0,"discount_percent":0,"label":"Tier 0"},
#               {"min_axgt":100,"discount_percent":5,"label":"Tier 1"}]'
#   2. AXGT_DISCOUNT_TIERS_FILE: path to a JSON file (same shape).
#   3. AXGT_DISCOUNT_TIERS: compact "min:percent[,min:percent...]" form
#      e.g.  AXGT_DISCOUNT_TIERS=0:0,100:5,1000:10,10000:15,100000:25
#
# Defaults (matches docs/TOKENOMICS.md):
#   Tier 0:        0 –     99 AXGT  →  0% discount
#   Tier 1:      100 –    999 AXGT  →  5% discount
#   Tier 2:    1,000 –  9,999 AXGT  → 10% discount
#   Tier 3:   10,000 – 99,999 AXGT  → 15% discount
#   Tier 4:  100,000+         AXGT  → 25% discount
# AXGT_DISCOUNT_TIERS=0:0,100:5,1000:10,10000:15,100000:25

# Legacy: direct AXGT deposits (AXGT-as-payment). Default false in ETH-first
# tokenomics. Set to true ONLY if you want to keep accepting AXGT as a direct
# payment token (e.g. for migration / private beta backward compatibility).
# AXGT_ENABLE_AXGT_DEPOSITS=false
# Legacy AXGT direct-deposit knobs (only consulted when AXGT_ENABLE_AXGT_DEPOSITS=true):
# AXGT_MIN_DEPOSIT=100
# AXGT_CREDIT_PER_100_AXGT_MINUTES=60

# CORS allowlist for /api/*. Empty = same-origin only.
# AXGT_CORS_ORIGINS=
# AXGT_RATE_LIMIT_PER_MIN=30

# ---- Postgres (deposit ledger, challenges, auth, sessions) ----
# Required for deposit-credit billing. With repo docker-compose.yml: NOT needed in .env —
# compose injects AXGT_CHALLENGE_DB_URL into the axonos container from the postgres service.
# Set here only for non-compose deploys or to point at an external database:
# AXGT_CHALLENGE_DB_URL=postgresql://user:pass@host:5432/dbname

# Credentials for the bundled postgres service (docker-compose). Override in .env if needed.
# POSTGRES_USER=axonos_gate
# POSTGRES_PASSWORD=axonos_gate_secret
# POSTGRES_DB=axonos_gate

# ---- Auth/session hardening ----
AXGT_AUTH_TOKEN_TTL_SECONDS=300
AXGT_CHALLENGE_TTL_SECONDS=180
AXGT_AUTH_COOKIE_NAME=axgt_auth_token
AXGT_AUTH_COOKIE_SECURE=true
AXGT_AUTH_ROTATE_BEFORE_EXPIRY_SECONDS=60
AXGT_AUTH_GRACE_SECONDS=15

# ---- Single-active-session lock & queue ----
# Idle session cap in minutes: extended on each heartbeat; session ends (container stopped) if
# no heartbeat for this long or AXGT_HEARTBEAT_TIMEOUT_SECONDS, whichever applies first.
AXGT_SESSION_MAX_MINUTES=60
# Seconds without a heartbeat before the session is considered stale and auto-released.
AXGT_HEARTBEAT_TIMEOUT_SECONDS=120
# Optional: cooldown in seconds before the same wallet can reclaim after releasing.
AXGT_SESSION_COOLDOWN_SECONDS=0
# Optional: shell script executed when the desktop session transitions between users.
# Default in container: /usr/local/bin/reset_session.sh (desktop cleanup + XFCE restart)
AXGT_SESSION_RESET_SCRIPT=/usr/local/bin/reset_session.sh

# ---- Multi-session (exclusive whole-GPU allocation) ----
# Enabled by default. Set to false only for legacy single-session deployments.
# AXGT_MULTI_SESSION_ENABLED=true
# AXGT_GPU_PROFILES_ENABLED=true
# Fixed profile map:
#   small=1 GPU, medium=2 GPUs, large=4 GPUs, max=8 GPUs
# Usage billing (with profiles enabled): deducts wall_clock_minutes × GPU count per heartbeat.
# Set AXGT_GPU_WEIGHTED_BILLING=false to bill 1× regardless of profile (not recommended).
# AXGT_DEFAULT_GPU_PROFILE=small
# AXGT_GPU_DEVICE_IDS=0,1,2,3,4,5,6,7
# AXGT_GPU_TOTAL_COUNT=8
# When unset, scheduler calls nvidia-smi to list visible GPU indices (Docker-friendly).
# AXGT_GPU_AUTO_DETECT=true
# TTL for cached auto-detected list (seconds).
# AXGT_GPU_DEVICE_CACHE_SECONDS=120
# GPU-less gate + http launcher: probe host via GET /enumerate-gpus on the launcher.
# AXGT_GPU_ENUMERATE_VIA_LAUNCHER=true
# AXGT_SESSION_LAUNCHER_ENUMERATE_TIMEOUT_SECONDS=90
# Optional smaller image for probe (default: AXGT_HOST_SESSION_CONTAINER_IMAGE).
# AXGT_LAUNCHER_GPU_ENUMERATE_IMAGE=nvidia/cuda:12.3.2-base-ubuntu22.04
#
# When prepaid credit hits zero, pause the session instead of destroying the container so the
# same desktop can resume after top-up (default true). Paused sessions expire after:
# AXGT_SESSION_PAUSED_MAX_MINUTES=120
# Set AXGT_SESSION_PRESERVE_ON_CREDIT_EXHAUST=false to restore legacy teardown-on-exhaust.
#
# Optional: one container per claimed session (exclusive assigned GPUs only).
# AXGT_USER_CONTAINER_ENABLED=true
# When true, base axonos is gate-only (AXGT_DESKTOP_ENABLED=false); desktops run in axgt-session-*.
# Do not add AXGT_DESKTOP_ENABLED to AXGT_HOST_SESSION_ENV_PASSTHROUGH (launcher forces true on sessions).
# AXGT_DESKTOP_ENABLED=false
# Base compose must not reserve GPUs when user containers are enabled (see docker-compose.yml axonos service).
# Launcher adapter mode:
#   docker_cli (default) -> runs `docker run` from gate runtime
#   http                -> delegates launch/stop to external launcher service
#   noop                -> scheduler-only dry run, no runtime orchestration
# AXGT_SESSION_LAUNCHER_MODE=http
# AXGT_SESSION_LAUNCHER_URL=http://axonos-launcher:8090
# AXGT_SESSION_LAUNCHER_TOKEN=replace_with_shared_secret
# AXGT_SESSION_LAUNCHER_TIMEOUT_SECONDS=10
#
# Compose-managed launcher defaults (recommended):
# - docker-compose starts `axonos-launcher` service automatically
# - gate uses AXGT_SESSION_LAUNCHER_MODE=http and URL http://axonos-launcher:8090
# - set a real shared secret for AXGT_SESSION_LAUNCHER_TOKEN in .env
#
# Host launcher bind (for compose launcher service or manual host service):
# AXGT_SESSION_LAUNCHER_BIND_HOST=127.0.0.1
# AXGT_SESSION_LAUNCHER_BIND_PORT=8090
# AXGT_HOST_SESSION_CONTAINER_IMAGE=axonos:public-beta
# AXGT_HOST_SESSION_CONTAINER_NETWORK=axonos_stack
# AXGT_HOST_SESSION_CONTAINER_COMMAND=/startup.sh
# AXGT_HOST_SESSION_CONTAINER_EXTRA_ARGS=-p 0:6080
# (Do not repeat --gpus here; it is set from the scheduled GPU assignment.)
# AXGT_HOST_SESSION_CONTAINER_SHM_SIZE=32g
# AXGT_HOST_SESSION_ENV_PASSTHROUGH=AXGT_CHAIN_ID,AXGT_RPC_URL,AXGT_CONTRACT_ADDRESS,AXGT_REVENUE_WALLET
# The launcher strips NVIDIA_VISIBLE_DEVICES (and similar) from its own environment when
# calling `docker run` so --gpus device=… is not merged with an implicit "all GPUs" request
# (daemon error: cannot set both Count and DeviceIDs on device request).
#
# docker_cli mode settings:
# AXGT_SESSION_CONTAINER_IMAGE=axonos:public-beta
# AXGT_SESSION_CONTAINER_EXTRA_ARGS=-p 0:6080
# AXGT_SESSION_CONTAINER_COMMAND=/startup.sh

# ---- Admin API (optional) ----
# Set to enable POST /api/admin/credit-minutes, refund-minutes, adjust-balance, GET /api/admin/ledger.
# Require header X-AXGT-Admin-Secret or query admin_secret.
# AXGT_ADMIN_SECRET=your_secret

# ---- Optional contract safety check ----
# If set, gate only accepts this contract address.
# AXGT_EXPECTED_CONTRACT_ADDRESS=0x6112C3509A8a787df576028450FebB3786A2274d

# ---- Gate server (when used, e.g. tunnel to 8889) ----
# GATE_HOST=0.0.0.0
# GATE_USE_GEVENT=1
# GATE_PORT=8889

# ---- WebRTC browser-native desktop streaming (optional) ----
# Set WEBRTC_ENABLED=true to prefer WebRTC; the UI falls back to noVNC/WebSockets unless WEBRTC_FALLBACK_ENABLED=false.
# WEBRTC_ENABLED=false
# WEBRTC_FALLBACK_ENABLED=true
# When AXGT_USER_CONTAINER_ENABLED=true, startup.sh disables the capture agent on the base
# container and the launcher passes WEBRTC_AGENT_ENABLED=true into axgt-session-* only (avoids
# two agents racing on the same signaling queue). Override only if you know what you are doing.
# WEBRTC_AGENT_ENABLED=true
# Shared secret for the in-container streaming agent (same value in gate + agent via env). Generate a long random string.
# WEBRTC_AGENT_INTERNAL_KEY=
# Gate URL for the WebRTC agent (signaling poll/answer POST). Default http://127.0.0.1:8889.
# Per-session axgt-session-* runs gate_server in the same container — leave unset so the agent uses localhost.
# Only set on the base axonos service if you run the agent there (not used when AXGT_USER_CONTAINER_ENABLED=true).
# WEBRTC_GATE_INTERNAL_URL=http://127.0.0.1:8889
# Seconds to wait for X11 (:0) before capture on a new session desktop (default 120).
# WEBRTC_DISPLAY_WAIT_SECONDS=120
# Browser polls for SDP answer this long (default 180000 ms; must exceed display wait + ICE).
# WEBRTC_ANSWER_WAIT_MS=180000
# Gate API bind (axonos service): use 0.0.0.0 so session agents reach http://axonos:8889.
# GATE_HOST=0.0.0.0
# GATE_PORT=8889
# Comma-separated ICE URLs (stun: and turn:). Do not embed TURN long-term passwords in repo — use env / secrets manager.
# WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
# WEBRTC_TURN_URLS=
# WEBRTC_TURN_USERNAME=
# WEBRTC_TURN_CREDENTIAL=
# WEBRTC_SESSION_TIMEOUT_SECONDS=600
# WEBRTC_MAX_RECONNECT_ATTEMPTS=5
# Rate limit signaling POSTs per IP+wallet per minute (0 = unlimited).
# WEBRTC_SIGNAL_RATE_LIMIT_PER_MIN=60
# Remote→browser clipboard poll uses X CLIPBOARD only (avoids PRIMARY noise like
# desktop icon labels overwriting the host clipboard). Set to 1 to include PRIMARY
# for legacy apps that never populate CLIPBOARD.
# WEBRTC_CLIPBOARD_POLL_PRIMARY=0
# Capture backend: auto (NvFBC when installed, else NVENC, else MSS/VP8), nvfbc, nvenc, or mss.
# WEBRTC_CAPTURE_BACKEND=auto
# WEBRTC_CAPTURE_DISPLAY=:0
# WEBRTC_CAPTURE_MAX_WIDTH=1920
# WEBRTC_CAPTURE_FPS=30
# NVENC H.264 target bitrate in bps (default 12000000 = 12 Mbps).
# For 1080p30, 10-14 Mbps is usually the useful range; lower this before
# lowering FPS if packet loss climbs through TURN.
# WEBRTC_CAPTURE_BITRATE=12000000
# NVENC preset (p1–p7; p1 has the lowest latency; p4 is cleaner but can lag).
# WEBRTC_CAPTURE_NVENC_PRESET=p1
# NVENC tune: ll (default), ull (lower delay/more artifacts), hq (cleaner/more delay).
# WEBRTC_CAPTURE_NVENC_TUNE=ll
# NvFBC streamer binary/preset. Requires building tools/nvfbc_nvenc_streamer.c with
# the NVIDIA Capture SDK headers.
# WEBRTC_CAPTURE_NVFBC_BIN=/usr/local/bin/nvfbc_nvenc_streamer
# WEBRTC_CAPTURE_NVFBC_PRESET=llhp
# One-frame VBV for absolute lowest latency; set false for ~3 frames of quality cushion.
# WEBRTC_CAPTURE_LOW_LATENCY=true
# Browser overlay cursor: auto (off when NVENC embeds host cursor), true, or false
# WEBRTC_LOCAL_CURSOR=auto

# ---- IPFS exposure (runtime, optional) ----
# Only set if you intentionally expose IPFS endpoints.
# IPFS_API_BIND=127.0.0.1
# IPFS_API_PORT=5001
# IPFS_GATEWAY_BIND=127.0.0.1
# IPFS_GATEWAY_PORT=8080

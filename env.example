## AxonOS environment configuration (example)
##
## Copy this file to `.env` and fill in values.
## Do NOT commit your `.env` file.
##
## Notes:
## - Values here are placeholders only (no hardcoded production values).
## - Some values are used at build-time (Docker build args), others at run-time (docker run env).

# ---- Build-time / VNC credentials ----
# Used as Docker build arg: --build-arg PASSWORD="$AXONOS_VNC_PASSWORD"
AXONOS_VNC_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ---- AXGT Gate / Wallet verification ----
AXGT_CONTRACT_ADDRESS=0xREPLACE_WITH_AXGT_CONTRACT_ADDRESS
AXGT_CHAIN_ID=REPLACE_WITH_CHAIN_ID
AXGT_RPC_URL=https://REPLACE_WITH_RPC_ENDPOINT
AXGT_MIN_HOLD_AMOUNT=100
AXGT_CREDIT_PER_100_AXGT_MINUTES=60
AXGT_WARNING_THRESHOLD_MINUTES=10
AXGT_USAGE_DB_PATH=/var/lib/axonos_gate/usage.json

# CORS allowlist for /api/auth/verify-wallet:
# - Empty means same-origin only (recommended)
# - "*" allows any origin (not recommended for public deployments)
# - Comma-separated exact origins: "https://example.com,http://localhost:6080"
AXGT_CORS_ORIGINS=

# Best-effort per-client rate limit (requests per minute). Set 0 to disable.
AXGT_RATE_LIMIT_PER_MIN=REPLACE_WITH_RATE_LIMIT_PER_MIN

# Optional hardening knobs
AXGT_AUTH_TOKEN_TTL_SECONDS=300
AXGT_CHALLENGE_TTL_SECONDS=180
AXGT_AUTH_COOKIE_NAME=axgt_auth_token
AXGT_AUTH_COOKIE_SECURE=true
AXGT_AUTH_ROTATE_BEFORE_EXPIRY_SECONDS=60
AXGT_AUTH_GRACE_SECONDS=15

# ---- IPFS exposure (runtime) ----
# Binding controls what IPFS listens on inside the container. You still must choose
# whether to publish host ports with docker -p.
IPFS_API_BIND=REPLACE_WITH_IP_BIND
IPFS_API_PORT=REPLACE_WITH_IPFS_API_PORT
IPFS_GATEWAY_BIND=REPLACE_WITH_IP_BIND
IPFS_GATEWAY_PORT=REPLACE_WITH_IPFS_GATEWAY_PORT


## AxonOS environment configuration (example)
##
## Copy this file to `.env` and fill in values.
## Do NOT commit your `.env` file.
##
## Notes:
## - Some values are used at build-time (Docker build arg PASSWORD), others at run-time.
## - For docker compose: AXONOS_VNC_PASSWORD is passed as build arg; all below are runtime env.

# ---- Build-time / VNC credentials ----
# Used as Docker build arg: --build-arg PASSWORD="$AXONOS_VNC_PASSWORD"
# IMPORTANT: set a strong value (used for VNC + in-container sudo)
AXONOS_VNC_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ---- AXGT Gate / Wallet verification ----
AXGT_CONTRACT_ADDRESS=0xREPLACE_WITH_AXGT_CONTRACT_ADDRESS
AXGT_CHAIN_ID=1
AXGT_RPC_URL=https://REPLACE_WITH_RPC_ENDPOINT

# CORS allowlist for /api/auth/*. Empty = same-origin only (recommended).
# Comma-separated exact origins or "*" (not recommended for production).
AXGT_CORS_ORIGINS=

# Best-effort per-client rate limit (requests per minute). Set 0 to disable.
AXGT_RATE_LIMIT_PER_MIN=30

# ---- Holding-credit policy (off-chain, global per wallet) ----
AXGT_MIN_HOLD_AMOUNT=100
AXGT_CREDIT_PER_100_AXGT_MINUTES=60
AXGT_WARNING_THRESHOLD_MINUTES=10
AXGT_USAGE_DB_PATH=/var/lib/axonos_gate/usage.json
AXGT_USAGE_RETENTION_DAYS=180

# ---- Auth/session hardening ----
AXGT_AUTH_TOKEN_TTL_SECONDS=300
AXGT_CHALLENGE_TTL_SECONDS=180
AXGT_AUTH_COOKIE_NAME=axgt_auth_token
AXGT_AUTH_COOKIE_SECURE=true
AXGT_AUTH_ROTATE_BEFORE_EXPIRY_SECONDS=60
AXGT_AUTH_GRACE_SECONDS=15

# ---- Optional contract safety check ----
# If set, gate only accepts this contract address.
# AXGT_EXPECTED_CONTRACT_ADDRESS=0x6112C3509A8a787df576028450FebB3786A2274d

# ---- Gate server (when used, e.g. tunnel to 8889) ----
# GATE_HOST=0.0.0.0
# GATE_USE_GEVENT=1
# GATE_PORT=8889

# ---- IPFS exposure (runtime, optional) ----
# Only set if you intentionally expose IPFS endpoints.
# IPFS_API_BIND=127.0.0.1
# IPFS_API_PORT=5001
# IPFS_GATEWAY_BIND=127.0.0.1
# IPFS_GATEWAY_PORT=8080
